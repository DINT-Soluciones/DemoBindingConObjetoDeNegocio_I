<Window x:Class="DemoBindingConObjetoDeNegocio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoBindingConObjetoDeNegocio"
        mc:Ignorable="d"
        Title="Binding con un objeto de negocio" 
        MinHeight="250" MinWidth="400"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel x:Name="datosStackPanel" Margin="40,10,110,40">
        
        <Label Content="Nombre:"
               Margin="5,20,5,0"
               HorizontalAlignment="Left"/>
        <TextBox x:Name="nombreTextBox" 
                 Margin="5,0,5,10" 
                 Width="150" 
                 HorizontalAlignment="Left"
                 Text="{Binding Path=Nombre, Mode=TwoWay}"
                 />

        <Label Content="Edad:"
               Margin="5,5,5,0"
               HorizontalAlignment="Left"/> 
        <TextBox x:Name="edadTextBox" 
                 Margin="5,0,5,20"
                 Width="50" 
                 HorizontalAlignment="Left"
                 Text="{Binding Path=Edad, Mode=TwoWay}"
                />

        <Button x:Name="button"
                Content="Consultar/Actualizar OBJETO"
                Margin="5"
                Width="200"
                Padding="5"
                HorizontalAlignment="Left"
                Click="button_Click"/>

    </StackPanel>
</Window>
